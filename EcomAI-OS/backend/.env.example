# EcomAI-OS — env template. COPY ME TO `.env` and fill in secrets; never commit `.env`.
# All values here are placeholders. The service-role key is SERVER-SIDE ONLY —
# it never appears in the browser bundle and never gets committed.

# Runtime: keep development local unless a real deployment is configured.
APP_ENV=development

# Operational switch: off (local in-memory tenant slice) by default.
USE_SUPABASE=false
MAX_UPLOAD_ROWS=250000
DEFAULT_JOB_TIMEOUT_S=300
SUPABASE_REQUEST_TIMEOUT_S=10
# Durable local job state. Use a mounted volume in a deployed process.
JOB_DATABASE_PATH=
# Exact comma-separated browser origins; wildcard origins are not used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# V2 authentication is fail-closed. Set a real secret (32+ bytes) before
# exposing any V2 route. `disabled` is only for explicit local development.
AUTH_MODE=jwt
# Optional offline password-backed issuer. Never enable in production or
# alongside Supabase; managed identity providers remain the production path.
LOCAL_AUTH_ENABLED=false
LOCAL_DATABASE_PATH=
LOCAL_AUTH_DATABASE_PATH=
ACCESS_TOKEN_TTL_SECONDS=3600
# JWT_ALGORITHM=HS256
# JWT_SECRET=
# SUPABASE_JWT_SECRET=  # HS256 auth secret; never the service-role key
# For asymmetric providers, set RS256 and configure a public key or JWKS URL:
# JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY=
# JWT_JWKS_URL=
# JWT_KEY_ID=
# JWT_JWKS_CACHE_SECONDS=300
# JWT_ISSUER=
# JWT_AUDIENCE=
JWT_CLOCK_SKEW_SECONDS=30
JWT_USER_ID_CLAIM=sub

# V1 is a legacy/global demo surface. It is disabled by default in
# production/Supabase; an explicit opt-in still requires a valid JWT.
V1_ENABLED=
V1_REQUIRE_AUTH=

# If you point the backend at a real Supabase project, set these server-side
# only. There are NO real credentials in this repo — these are placeholders.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=  # legacy alias for SUPABASE_PUBLISHABLE_KEY
