# EcomAI-OS root environment template.
# Copy to `.env` only for local development. Never commit real credentials.

APP_ENV=development
USE_SUPABASE=false
MAX_UPLOAD_ROWS=250000
DEFAULT_JOB_TIMEOUT_S=300
SUPABASE_REQUEST_TIMEOUT_S=10
JOB_DATABASE_PATH=
# Exact comma-separated browser origins; wildcard origins are not used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT verification (V2 always fails closed without a real configuration).
AUTH_MODE=jwt
# Optional offline password-backed issuer; keep disabled publicly.
LOCAL_AUTH_ENABLED=false
LOCAL_DATABASE_PATH=
LOCAL_AUTH_DATABASE_PATH=
ACCESS_TOKEN_TTL_SECONDS=3600
JWT_ALGORITHM=HS256
# JWT_SECRET=
# SUPABASE_JWT_SECRET=
# JWT_ISSUER=
# JWT_AUDIENCE=
JWT_CLOCK_SKEW_SECONDS=30
JWT_USER_ID_CLAIM=sub

# Asymmetric alternatives. Exactly one algorithm is accepted at a time, on
# purpose: accepting two at once would widen the verification surface. The
# token's own `alg` header can never select which one is used.
#
# RS256 (RSA):
# JWT_ALGORITHM=RS256
#
# ES256 (ECDSA P-256) -- what Supabase Auth signs with by default. Requires the
# `cryptography` package; JWT_PUBLIC_KEY is the EC public key, JWT_JWKS_URL the
# project's JWKS endpoint. Either one is enough.
# JWT_ALGORITHM=ES256
# JWT_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# JWT_PUBLIC_KEY=
#
# Shared by both. JWT_KEY_ID pins the signing key, which is worth setting if the
# provider ever rotates to a second key: a token signed with any other key is
# then refused instead of accepted.
# JWT_KEY_ID=
# JWT_JWKS_CACHE_SECONDS=300

# Legacy V1 is not tenant-isolated. Keep it disabled for public deployments.
# When enabled, every V1 endpoint requires a valid JWT (default when blank).
V1_ENABLED=
V1_REQUIRE_AUTH=true

# Supabase server-side configuration (placeholders only; never real keys).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# Password reset. Must be an absolute http(s) URL, and must be allow-listed in
# the Supabase dashboard under Authentication > URL Configuration > Redirect
# URLs or GoTrue rejects the request and no mail is sent. This is the page the
# emailed recovery link lands on, so it is a security boundary: a value
# allow-listed in error would hand a recovery token to another origin.
# PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
