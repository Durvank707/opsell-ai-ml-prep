# EcomAI-OS root environment template.
# Copy to `.env` only for local development. Never commit real credentials.

APP_ENV=development
USE_SUPABASE=false
MAX_UPLOAD_ROWS=250000
DEFAULT_JOB_TIMEOUT_S=300
SUPABASE_REQUEST_TIMEOUT_S=10
JOB_DATABASE_PATH=
# Exact comma-separated browser origins; wildcard origins are not used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT verification (V2 always fails closed without a real configuration).
AUTH_MODE=jwt
# Optional offline password-backed issuer; keep disabled publicly.
LOCAL_AUTH_ENABLED=false
LOCAL_DATABASE_PATH=
LOCAL_AUTH_DATABASE_PATH=
ACCESS_TOKEN_TTL_SECONDS=3600
JWT_ALGORITHM=HS256
# JWT_SECRET=
# SUPABASE_JWT_SECRET=
# JWT_ISSUER=
# JWT_AUDIENCE=
JWT_CLOCK_SKEW_SECONDS=30
JWT_USER_ID_CLAIM=sub

# RS256 alternative:
# JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY=
# JWT_JWKS_URL=
# JWT_KEY_ID=
# JWT_JWKS_CACHE_SECONDS=300

# Legacy V1 is not tenant-isolated. Keep it disabled for public deployments.
V1_ENABLED=
V1_REQUIRE_AUTH=

# Supabase server-side configuration (placeholders only; never real keys).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
