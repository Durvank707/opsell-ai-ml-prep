# EcomAI-OS frontend configuration template.
# Copy to `.env.local` and fill values from your identity provider.
# Never put a service-role key or JWT signing secret in a VITE_* variable.

# Keep `mock` for the self-contained demo UI. Use `backend` for the opt-in
# local FastAPI password issuer, or `external` when a managed provider owns
# login and injects an access token.
VITE_AUTH_MODE=mock

# Optional API origin. Leave empty to use the Vite `/api` proxy.
# VITE_API_BASE_URL=http://localhost:8000/api

# Optional provider endpoints used only when no window.__ECOMAI_OS_AUTH__
# adapter is installed by the host application.
# VITE_AUTH_LOGIN_URL=/auth/login
# VITE_AUTH_SIGNUP_URL=/auth/signup
